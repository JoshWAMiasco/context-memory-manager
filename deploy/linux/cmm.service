# CMM (Context Memory Manager) server, installed by install.sh as /etc/systemd/system/cmm.service.
# Storage roots are opened to the service by the drop-in cmm.service.d/storage.conf, which
# `cmm add-storage` and `cmm remove-storage` regenerate. The cmm user is in plugdev (when that
# group exists) through its own group list, so no SupplementaryGroups= line is needed here.
[Unit]
Description=CMM Context Memory Manager
After=network-online.target udisks2.service
Wants=network-online.target

[Service]
Type=simple
User=cmm
Group=cmm
Environment=CMM_MODE=server CMM_CONFIG=/etc/cmm/config.json CMM_DATA_DIR=/var/lib/cmm NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
ExecStart=/opt/cmm/current/node/bin/node /opt/cmm/current/app/entry.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
# lsblk and udisks need to see the block devices.
PrivateDevices=no
ReadWritePaths=/var/lib/cmm
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
KeyringMode=private
RemoveIPC=yes
UMask=0027

[Install]
WantedBy=multi-user.target
