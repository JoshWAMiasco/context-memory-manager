# Copy to .env (never committed) to set these for `npm run dev` and `npm start`.
# Every value here is optional; CMM runs with its defaults without a .env file.

# Keep Next.js from sending anonymous usage data (the npm scripts set this too).
NEXT_TELEMETRY_DISABLED=1

# "desktop" (the Electron app) or "server". The npm scripts set it; leave it unset otherwise.
# CMM_MODE=server

# Where CMM keeps its database, settings and trash. Defaults: ~/.cmm (desktop), /var/lib/cmm (server).
# CMM_DATA_DIR=.cmm-dev-data

# The config file to read (storage roots, port, TLS). Defaults to <data dir>/config.json.
# CMM_CONFIG=.cmm-dev-data/config.json

# Server mode: the address and port to listen on. Defaults: 0.0.0.0 and 7420.
# HOSTNAME=0.0.0.0
# PORT=7420
