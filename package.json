{
  "name": "context-memory-manager",
  "version": "0.1.0",
  "private": true,
  "description": "CMM (Context Memory Manager): a self-hosted file manager for LLM context, memories and private files.",
  "license": "MIT",
  "author": "Joshua Miasco",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshWAMiasco/context_memory_manager.git"
  },
  "scripts": {
    "dev": "tsx scripts/clear-stale-dev-cache.ts && tsx scripts/copy-pdfjs-assets.ts && cross-env NEXT_TELEMETRY_DISABLED=1 tsx scripts/build-entry.ts && cross-env NEXT_TELEMETRY_DISABLED=1 CMM_MODE=server CMM_DATA_DIR=.cmm-dev-data CMM_CONFIG=.cmm-dev-data/config.json node dist/server/entry.js --dev",
    "build": "tsx scripts/clean-build-output.ts && tsx scripts/gen-licenses.ts && tsx scripts/copy-pdfjs-assets.ts && cross-env NEXT_TELEMETRY_DISABLED=1 next build && npm run build:entry && tsx scripts/assemble-app.ts && npm run build:electron && npm run docs:pdf",
    "build:entry": "cross-env NEXT_TELEMETRY_DISABLED=1 tsx scripts/build-entry.ts",
    "build:electron": "tsx scripts/build-electron.ts",
    "build:desktop": "tsx scripts/build-desktop.ts",
    "package:server": "tsx scripts/package-server.ts",
    "icons:app": "tsx scripts/gen-app-icons.ts",
    "docs:pdf": "tsx scripts/build-guides-pdf.ts",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 node dist/app/entry.js",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:offline": "tsx scripts/copy-pdfjs-assets.ts && cross-env NEXT_TELEMETRY_DISABLED=1 next build && tsx scripts/check-offline-bundle.ts",
    "check:offline:nobuild": "tsx scripts/check-offline-bundle.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/run-migrations.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@floating-ui/react": "0.27.20",
    "@headlessui/react": "2.2.10",
    "@hookform/resolvers": "5.9.2",
    "@lezer/highlight": "1.2.5",
    "@node-rs/argon2": "2.2.2",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.14",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "archiver": "7.0.1",
    "better-sqlite3": "13.0.3",
    "chokidar": "4.0.3",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "drizzle-orm": "0.45.4",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.61.0",
    "motion": "14.1.0",
    "next": "16.4.2",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.4.299",
    "picomatch": "4.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.3",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "selfsigned": "5.5.0",
    "server-only": "0.0.1",
    "simple-git": "4.0.2",
    "sonner": "2.0.8",
    "systeminformation": "5.33.15",
    "tailwind-merge": "3.7.0",
    "trash": "10.1.1",
    "vscode-icons-js": "11.6.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/archiver": "7.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.11",
    "electron": "45.0.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-unicorn": "65.0.1",
    "marked": "18.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@peculiar/asn1-cms": "2.10.0",
    "@peculiar/asn1-csr": "2.10.0",
    "@peculiar/asn1-ecc": "2.10.0",
    "@peculiar/asn1-pfx": "2.10.0",
